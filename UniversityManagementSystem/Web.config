<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add
      name="UmsDb"
      connectionString="Server=.;Database=UmsDb;Trusted_Connection=True;"
      providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="Ai:Provider" value="Mock" />
    <add key="Ai:Endpoint" value="https://api.openai.com/v1/chat/completions" />
    <add key="Ai:ApiKey" value="" />
    <add key="Ai:Model" value="gpt-4o-mini" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
  </system.web>
</configuration>
